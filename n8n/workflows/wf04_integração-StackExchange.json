    {
      "parameters": {
        "jsCode": "// Validação de unicidade de source_id\n// Mode: Run Once for All Items\n\nconst items = $input.all();\nconst occurrences = new Map();\nconst missingIds = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const rawId = items[i].json.source_id;\n\n  if (\n    rawId === undefined ||\n    rawId === null ||\n    String(rawId).trim() === \"\"\n  ) {\n    missingIds.push(i);\n    continue;\n  }\n\n  const id = String(rawId).trim();\n\n  if (!occurrences.has(id)) {\n    occurrences.set(id, []);\n  }\n\n  occurrences.get(id).push(i);\n}\n\nconst duplicates = [...occurrences.entries()]\n  .filter(([id, indexes]) => indexes.length > 1)\n  .map(([source_id, indexes]) => ({\n    source_id,\n    occurrences: indexes.length,\n    itemIndexes: indexes,\n  }));\n\nif (missingIds.length > 0 || duplicates.length > 0) {\n  throw new Error(\n    [\n      \"Falha de integridade: source_id ausente ou duplicado.\",\n      `IDs ausentes: ${missingIds.length}.`,\n      `IDs duplicados: ${duplicates.length}.`,\n      `Detalhes: ${JSON.stringify({\n        missingIdIndexes: missingIds,\n        duplicates,\n      })}`,\n    ].join(\" \")\n  );\n}\n\n// Sem duplicidades e sem IDs ausentes:\n// preserva todos os registros originais.\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
