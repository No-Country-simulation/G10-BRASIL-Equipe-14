    {
      "parameters": {
        "jsCode": "// WF04 - Validação dos dados após o Merge\n// Modo: Run Once for All Items\n\nconst items = $input.all();\nconst totalItems = items.length;\n\nconst missingQuestionId = [];\nconst missingContentLicense = [];\nconst duplicateQuestionIds = [];\nconst questionIds = new Set();\n\nfor (let i = 0; i < items.length; i++) {\n  const data = items[i].json;\n  const questionId = data.source_id;\n\n  // Verifica source_id\n  if (\n    questionId === undefined ||\n    questionId === null ||\n    String(questionId).trim() === \"\"\n  ) {\n    missingQuestionId.push(i);\n  } else {\n    const id = String(questionId);\n\n    if (questionIds.has(id)) {\n      duplicateQuestionIds.push(id);\n    } else {\n      questionIds.add(id);\n    }\n  }\n\n  // Verifica content_license\n  if (\n    data.content_license === undefined ||\n    data.content_license === null ||\n    String(data.content_license).trim() === \"\"\n  ) {\n    missingContentLicense.push(\n      questionId ?? `índice ${i}`\n    );\n  }\n}\n\nconst checks = {\n  quantidadeEsperada: totalItems === 154,\n  todosPossuemQuestionId: missingQuestionId.length === 0,\n  todosPossuemContentLicense: missingContentLicense.length === 0,\n  semQuestionIdDuplicado: duplicateQuestionIds.length === 0,\n};\n\nconst valid = Object.values(checks).every(Boolean);\n\nreturn [\n  {\n    json: {\n      valid,\n      totalItems,\n      questionIdsUnicos: questionIds.size,\n      checks,\n      problemas: {\n        questionIdAusenteNosIndices: missingQuestionId,\n        contentLicenseAusenteNasPerguntas: missingContentLicense,\n        questionIdsDuplicados: [...new Set(duplicateQuestionIds)],\n      },\n    },\n  },\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1056,
        -336
      ],
