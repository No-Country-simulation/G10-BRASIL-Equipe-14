    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\n  const value = item.json.folder;\n\n  const invalid = (message) => ({\n    json: {\n      ...item.json,\n      valid: false,\n      statusCode: 400,\n      error: 'INVALID_FOLDER',\n      message,\n    },\n    pairedItem: { item: index },\n  });\n\n  if (typeof value !== 'string' || value.trim() === '') {\n    return invalid('Informe uma pasta não vazia.');\n  }\n\n  const folder = value.trim();\n\n  if (\n    folder.startsWith('/') ||\n    folder.includes('\\\\') ||\n    /[\\u0000-\\u001F\\u007F]/.test(folder)\n  ) {\n    return invalid(\n      'Use um caminho relativo com barras / e sem caracteres de controle.'\n    );\n  }\n\n  // Remove somente a barra final antes de validar os segmentos.\n  const path = folder.endsWith('/') ? folder.slice(0, -1) : folder;\n  const segments = path.split('/');\n\n  if (\n    segments.some(\n      (segment) => segment === '' || segment === '.' || segment === '..'\n    )\n  ) {\n    return invalid('A pasta contém segmentos vazios, \".\" ou \"..\".');\n  }\n\n  return {\n    json: {\n      ...item.json,\n      folder: `${path}/`,\n      valid: true,\n    },\n    pairedItem: { item: index },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        192
      ],
