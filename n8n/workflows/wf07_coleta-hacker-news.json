    {
      "parameters": {
        "path": "hacker-news-search",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        -160
      ],
      "id": "9559eb93-f1b5-4ddb-a446-ed94267f5e44",
      "name": "Webhook",
      "webhookId": "4cb5e69f-07c2-4bf9-9e76-faae494a09ee"
    },
    {
      "parameters": {
        "url": "https://hn.algolia.com/api/v1/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.query.query?.trim() || (() => { throw new Error('O parâmetro query é obrigatório e não pode estar vazio.') })() }}"
            },
            {
              "name": "tags",
              "value": "={{ $json.query.type ? $json.query.type : 'story' }}"
            },
            {
              "name": "hitsPerPage",
              "value": "={{ Math.min(100, Math.max(1, Number($json.query.limit) || 100)) }}"
            },
            {
              "name": "numericFilters",
              "value": "={{\n  'created_at_i>=' +\n  Math.floor(\n    Number($json.query?.fromdate ?? $json.body?.fromdate) ||\n    (Date.now() / 1000 - 30 * 24 * 60 * 60)\n  ) +\n  (\n    ($json.query?.type ?? 'story') === 'story'\n      ? ',points>=' + Math.max(0, Number($json.query?.minPoints) || 0)\n      : ''\n  )\n}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        -160
      ],
      "id": "d519a233-85e6-4976-864b-0659bfc74842",
      "name": "Pesquisar Hacker News"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $('Pesquisar Hacker News').first().json }}",
        "options": {
          "responseCode": 200
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1120,
        -160
      ],
      "id": "4fe08195-2bd8-470a-a9a7-3b450e25dbf7",
      "name": "Responder Pesquisa Hacker News"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "3bc6f3b6-875f-413d-84c3-fd8db7c4fd9b",
              "leftValue": "={{ $json.query.query ?? '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
