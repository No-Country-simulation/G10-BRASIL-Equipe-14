    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst isNonEmptyString = (value) =>\n  typeof value === 'string' && value.trim().length > 0;\n\nconst normalizeText = (value) =>\n  typeof value === 'string'\n    ? value.trim().replace(/\\s+/g, ' ')\n    : value;\n\nconst sanitized = [];\nlet rejected = 0;\n\nfor (const item of items) {\n  const q = item.json;\n\n  // Validar os campos essenciais para identificar a pergunta.\n  if (\n    q.source_id === null ||\n    q.source_id === undefined ||\n    !isNonEmptyString(q.title) ||\n    !isNonEmptyString(q.body) ||\n    !isNonEmptyString(q.link)\n  ) {\n    rejected++;\n    continue;\n  }\n\n  // Preservar o HTML de body, incluindo exemplos de código.\n  const body =\n    typeof q.body === 'string' ? q.body.trim() : '';\n\n  // Garantir que tags seja sempre um array de strings.\n  const tags = Array.isArray(q.tags)\n    ? q.tags\n        .filter((tag) => typeof tag === 'string')\n        .map((tag) => tag.trim())\n        .filter((tag) => tag.length > 0)\n    : [];\n\n  sanitized.push({\n    json: {\n      ...q,\n      source_id: String(q.source_id).trim(),\n      owner: normalizeText(q.owner ?? ''),\n      title: normalizeText(q.title),\n      body,\n      link: q.link.trim(),\n      tags,\n    },\n  });\n}\n\nconsole.log(\n  `Sanitização concluída: ${sanitized.length} registros válidos; ${rejected} rejeitados.`\n);\n\nreturn sanitized;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1488,
        -208
      ],
      "id": "ad6cf6b6-11c0-4013-a1b2-19ffe418cbe0",
      "name": "Sanitizar e Validar Perguntas"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map((item) => {\n  const q = item.json;\n  const errors = [];\n\n  const { tagged, fromdate, pagesize } = q;\n\n  // Validar as tags de busca.\n  if (\n    typeof tagged !== 'string' ||\n    tagged.trim().length === 0 ||\n    tagged.trim().length > 200 ||\n    !/^[a-zA-Z0-9.+#_;-]+$/.test(tagged.trim())\n  ) {\n    errors.push(\n      'tagged deve conter tags válidas separadas por ponto e vírgula.'\n    );\n  }\n\n  // Validar o timestamp Unix em segundos.\n  if (\n    !Number.isSafeInteger(fromdate) ||\n    fromdate <= 0\n  ) {\n    errors.push(\n      'fromdate deve ser um timestamp Unix inteiro positivo em segundos.'\n    );\n  } else if (fromdate > Math.floor(Date.now() / 1000)) {\n    errors.push('fromdate não pode estar no futuro.');\n  }\n\n  // Validar o tamanho da página.\n  if (\n    !Number.isInteger(pagesize) ||\n    pagesize < 1 ||\n    pagesize > 100\n  ) {\n    errors.push(\n      'pagesize deve ser um inteiro entre 1 e 100.'\n    );\n  }\n\n  if (errors.length > 0) {\n    return {\n      json: {\n        ...q,\n        _validation: {\n          valid: false,\n          message: errors.join(' '),\n        },\n      },\n    };\n  }\n\n  return {\n    json: {\n      ...q,\n      tagged: tagged.trim(),\n      fromdate,\n      pagesize,\n      _validation: {\n        valid: true,\n        message: '',\n      },\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
