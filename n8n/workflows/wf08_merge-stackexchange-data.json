    {
      "parameters": {
        "jsCode": "const inputItems = $input.all();\n\n// Estrutura para acumular os dados por source_id\nconst records = new Map();\n\nfunction getRecord(sourceId) {\n  const id = String(sourceId ?? '').trim();\n\n  if (!id) return null;\n\n  if (!records.has(id)) {\n    records.set(id, {\n      source_id: id,\n      question: null,\n      license: null,\n      answers: [],\n    });\n  }\n\n  return records.get(id);\n}\n\nfor (const item of inputItems) {\n  const data = item.json;\n\n  // Processar perguntas\n  for (const question of data.questions ?? []) {\n    const record = getRecord(question.source_id);\n    if (!record) continue;\n\n    record.question = {\n      ...(record.question ?? {}),\n      ...question,\n    };\n  }\n\n  // Processar licenças\n  for (const license of data.licenses ?? []) {\n    const record = getRecord(license.source_id);\n    if (!record) continue;\n\n    record.license = {\n      ...(record.license ?? {}),\n      ...license,\n    };\n  }\n\n  // Processar respostas\n  for (const answer of data.answers ?? []) {\n    const record = getRecord(answer.source_id);\n    if (!record) continue;\n\n    record.answers.push(answer);\n  }\n}\n\n// Montar a saída: um item por source_id\nreturn Array.from(records.values()).map(record => ({\n  json: {\n    source_id: record.source_id,\n    ...(record.question ?? {}),\n    ...(record.license ?? {}),\n    answers: record.answers,\n  },\n}));"
      },
