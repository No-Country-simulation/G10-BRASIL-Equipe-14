      "id": "4febdd21-7332-4a6e-b54e-db1e9346626d",
      "name": "Responder Erro de Validação"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst isNonEmptyString = (value) =>\n  typeof value === 'string' && value.trim().length > 0;\n\nconst normalizeText = (value) =>\n  typeof value === 'string'\n    ? value.trim().replace(/\\s+/g, ' ')\n    : value;\n\nconst sanitized = [];\nlet rejected = 0;\n\nfor (const item of items) {\n  const q = item.json;\n\n  // Identificar os campos dinâmicos de cada resposta.\n  const answerTitleKeys = Object.keys(q).filter((key) =>\n    /^title_answer_\\d+$/.test(key)\n  );\n\n  // Validar os campos essenciais da pergunta de origem.\n  if (\n    q.source_id === null ||\n    q.source_id === undefined ||\n    !isNonEmptyString(String(q.source_id)) ||\n    answerTitleKeys.length === 0\n  ) {\n    rejected++;\n    continue;\n  }\n\n  // Preservar todos os campos originais e normalizar os valores.\n  const normalized = {\n    ...q,\n    source_id: String(q.source_id).trim(),\n  };\n\n  // Normalizar os campos de cada resposta sem alterar o HTML.\n  for (const titleKey of answerTitleKeys) {\n    const accountId = titleKey.match(/^title_answer_(\\d+)$/)[1];\n\n    const fields = [\n      ['title', 'string'],\n      ['body', 'html'],\n      ['link', 'string'],\n      ['content_license', 'string'],\n      ['comment_count', 'number'],\n      ['down_vote_count', 'number'],\n      ['up_vote_count', 'number'],\n      ['score', 'number'],\n      ['last_activity_date', 'number'],\n      ['creation_date', 'number'],\n      ['is_accepted_answer', 'boolean'],\n    ];\n\n    for (const [field, type] of fields) {\n      const key = `${field}_answer_${accountId}`;\n\n      if (!(key in q)) continue;\n\n      const value = q[key];\n\n      if (type === 'html') {\n        // Preservar tags HTML, quebras de linha e código.\n        normalized[key] =\n          typeof value === 'string' ? value.trim() : '';\n      } else if (type === 'string') {\n        normalized[key] =\n          typeof value === 'string' ? normalizeText(value) : value;\n      }\n    }\n\n    // Normalizar o objeto do proprietário da resposta.\n    const ownerKey = `owner_answer_${accountId}`;\n\n    if (q[ownerKey] && typeof q[ownerKey] === 'object') {\n      normalized[ownerKey] = { ...q[ownerKey] };\n\n      if (typeof q[ownerKey].display_name === 'string') {\n        normalized[ownerKey].display_name =\n          normalizeText(q[ownerKey].display_name);\n      }\n\n      if (typeof q[ownerKey].link === 'string') {\n        normalized[ownerKey].link = q[ownerKey].link.trim();\n      }\n    }\n  }\n\n  sanitized.push({ json: normalized });\n}\n\nconsole.log(\n  `Sanitização concluída: ${sanitized.length} registros válidos; ${rejected} rejeitados.`\n);\n\nreturn sanitized;"
      },
