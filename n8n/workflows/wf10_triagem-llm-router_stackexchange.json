      "id": "af2b6575-a0ae-4e44-9b44-4a8ff94a9a67",
      "name": "SKill Router Classification"
    },
    {
      "parameters": {
        "jsCode": "// Code v2 — JavaScript — Run Once for All Items\nconst inputs = $input.all();\n\nconst fields = [\n  'original_language', 'sentiment', 'strength', 'confidence',\n];\nconst languages = new Set(['pt', 'es', 'en', 'other']);\nconst sentiments = new Set([\n  'Excited', 'Happy', 'Neutral', 'Disappointed', 'Angry',\n]);\n\nfunction fail(message) {\n  throw new Error(`Merge Classifications: ${message}`);\n}\n\nfunction object(value, label) {\n  if (!value || typeof value !== 'object' || Array.isArray(value)) {\n    fail(`${label}: objeto inválido`);\n  }\n  return value;\n}\n\nfunction sourceId(value, label) {\n  if (typeof value === 'number' && Number.isSafeInteger(value)) {\n    return String(value);\n  }\n  if (typeof value === 'string' && value.trim() !== '') {\n    return value;\n  }\n  fail(`${label}: source_id ausente ou inválido`);\n}\n\nfunction answerId(value, label) {\n  // Normaliza somente a chave de comparação; preserva o valor original.\n  if (typeof value === 'number' &&\n      Number.isSafeInteger(value) && value > 0) {\n    return String(value);\n  }\n  if (typeof value === 'string' && /^[1-9]\\d*$/.test(value)) {\n    return value;\n  }\n  fail(`${label}: answer_id ausente ou inválido`);\n}\n\nfunction indexAnswers(value, label) {\n  if (!Array.isArray(value)) fail(`${label}: answers não é array`);\n\n  const index = new Map();\n  value.forEach((answer, position) => {\n    object(answer, `${label}.answers[${position}]`);\n    const key = answerId(answer.answer_id, label);\n    if (index.has(key)) fail(`${label}: answer_id duplicado ${key}`);\n    index.set(key, answer);\n  });\n  return index;\n}\n\nfunction sameIds(left, right, label) {\n  const missing = [...left.keys()].filter(id => !right.has(id));\n  const extra = [...right.keys()].filter(id => !left.has(id));\n  if (missing.length || extra.length) {\n    fail(`${label}: ausentes=[${missing}]; sem correspondência=[${extra}]`);\n  }\n}\n\nreturn inputs.map((item, i) => {\n  let original;\n  let sent;\n\n  try {\n    original = $('Filter').itemMatching(i).json;\n    sent = $('Limit').itemMatching(i).json;\n  } catch (error) {\n    fail(`item ${i}: item linking indisponível ou ambíguo`);\n  }\n\n  object(original, 'original');\n  object(sent, 'entrada do agente');\n\n  let result = item.json.output;\n  if (typeof result === 'string') {\n    try {\n      result = JSON.parse(result);\n    } catch (error) {\n      fail(`item ${i}: output não contém JSON válido`);\n    }\n  }\n  object(result, 'output');\n\n  const expectedId = sourceId(sent.source_id, 'entrada do agente');\n  if (sourceId(original.source_id, 'original') !== expectedId ||\n      sourceId(result.source_id, 'output') !== expectedId) {\n    fail(`item ${i}: source_id divergente`);\n  }\n\n  if (sent.source !== 'stackoverflow' || result.source !== sent.source) {\n    fail(`item ${i}: source divergente`);\n  }\n  if (Object.prototype.hasOwnProperty.call(original, 'source') &&\n      original.source !== sent.source) {\n    fail(`item ${i}: source original divergente`);\n  }\n\n  const originals = indexAnswers(original.answers, 'original');\n  const sentAnswers = indexAnswers(sent.answers, 'entrada do agente');\n  const classifications = indexAnswers(result.answers, 'output');\n\n  sameIds(originals, sentAnswers, 'original versus entrada do agente');\n  sameIds(originals, classifications, 'original versus output');\n\n  for (const [id, classification] of classifications) {\n    if (!Number.isSafeInteger(classification.answer_id) ||\n        classification.answer_id <= 0) {\n      fail(`resposta ${id}: output exige answer_id inteiro positivo`);\n    }\n    if (!languages.has(classification.original_language) ||\n        !sentiments.has(classification.sentiment)) {\n      fail(`resposta ${id}: idioma ou sentimento inválido`);\n    }\n    for (const field of ['strength', 'confidence']) {\n      const value = classification[field];\n      if (typeof value !== 'number' ||\n          !Number.isFinite(value) || value < 0 || value > 1) {\n        fail(`resposta ${id}: ${field} inválido`);\n      }\n    }\n  }\n\n  // Clona dados JSON para não modificar os objetos dos nós anteriores.\n  const merged = JSON.parse(JSON.stringify(original));\n\n  for (const answer of merged.answers) {\n    const id = answerId(answer.answer_id, 'original');\n    const classification = classifications.get(id);\n\n    for (const field of fields) {\n      if (Object.prototype.hasOwnProperty.call(answer, field)) {\n        fail(`resposta ${id}: campo ${field} já existe no original`);\n      }\n      answer[field] = classification[field];\n    }\n  }\n\n  return {\n    json: merged,\n    pairedItem: { item: i },\n  };\n});"
      },
