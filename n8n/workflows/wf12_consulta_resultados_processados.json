    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst request = $('Validate Request').first().json;\n\nif (!Array.isArray(input.data)) {\n  return [{\n    json: {\n      success: false,\n      statusCode: 502,\n      source: request.source,\n      tag: request.tag,\n      object_key: request.object_key,\n      error: {\n        code: 'INVALID_PROCESSED_DATA',\n        message: 'O arquivo processado deve conter um array JSON.',\n      },\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    statusCode: 200,\n    source: request.source,\n    tag: request.tag,\n    object_key: request.object_key,\n    count: input.data.length,\n    items: input.data,\n  },\n}];"
      },
