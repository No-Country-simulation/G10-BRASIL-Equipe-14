    },
    {
      "parameters": {
        "jsCode": "const query = $input.first().json.query;\n\nfunction invalid(message) {\n  return [{\n    json: {\n      success: false,\n      statusCode: 400,\n      error: {\n        code: 'INVALID_QUERY',\n        message,\n      },\n    },\n  }];\n}\n\nif (!query || typeof query !== 'object' || Array.isArray(query)) {\n  return invalid('Informe os parâmetros source e tag em query.');\n}\n\nconst allowedSources = ['stackoverflow', 'mastodon', 'hackernews'];\n\nif (\n  typeof query.source !== 'string' ||\n  !allowedSources.includes(query.source)\n) {\n  return invalid(\n    'source deve ser stackoverflow, mastodon ou hackernews.'\n  );\n}\n\n// A tag deve corresponder exatamente ao tópico no nome do arquivo.\n// Não removemos espaços ou hífens automaticamente.\nif (\n  typeof query.tag !== 'string' ||\n  query.tag.length > 200 ||\n  !/^[a-zA-Z0-9][a-zA-Z0-9.+#_;-]*$/.test(query.tag)\n) {\n  return invalid(\n    'tag deve ter entre 1 e 200 caracteres, começar com letra ou número ' +\n    'e conter apenas letras, números, ponto, +, #, _, ; ou hífen.'\n  );\n}\n\nconst source = query.source;\nconst tag = query.tag;\n\nreturn [{\n  json: {\n    success: true,\n    source,\n    tag,\n    object_key: `processed/result_${source}_${tag}.json`,\n  },\n}];"
      },
