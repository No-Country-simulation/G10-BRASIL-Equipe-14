    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// A saída observada fornece apenas a mensagem, sem código HTTP.\nconst message = typeof input.error === 'string'\n  ? input.error.trim()\n  : '';\n\nconst notFound =\n  message === 'The resource you are requesting could not be found';\n\nreturn [{\n  json: {\n    success: false,\n    statusCode: notFound ? 404 : 502,\n    source: input.source,\n    tag: input.tag,\n    object_key: input.object_key,\n    error: {\n      code: notFound\n        ? 'PROCESSED_FILE_NOT_FOUND'\n        : 'STORAGE_DOWNLOAD_FAILED',\n      message: notFound\n        ? 'Nenhum arquivo processado foi encontrado para a fonte e o tópico informados.'\n        : 'Não foi possível recuperar o arquivo processado na OCI.',\n    },\n  },\n}];"
      },
