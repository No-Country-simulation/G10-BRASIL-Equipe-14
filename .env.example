# n8n
N8N_VERSION=2.41.3
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
TIMEZONE=America/Sao_Paulo

# Streamlit
STREAMLIT_PORT=8501

# Streamlit -> n8n (no docker compose use N8N_BASE_URL=http://n8n:5678)
N8N_BASE_URL=http://localhost:5678
N8N_INGESTION_WEBHOOK_PATH=webhook/ingestion
# N8N_INGESTION_WEBHOOK_URL=   # opcional: sobrescreve BASE_URL + PATH
N8N_REQUEST_TIMEOUT=30

# Chat do Dashboard -> WF13 (chave da credencial Header Auth)
N8N_API_KEY=
N8N_SENTIMENT_CHAT_WEBHOOK_URL=https://bot.rsa.ia.br/webhook/wf13-sentimento-chat

# Armazenamento OCI (S2-04)
# Credenciais ficam no ~/.oci/config, não aqui.
OCI_NAMESPACE=grue2tm7tuaq
OCI_BUCKET_NAME=communitylab-assets

# LLMs 
GEMINI_API_KEY=SUA_CHAVE_AQUI
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=SUA_CHAVE_AQUI
GROQ_MODEL=llama-3.3-70b-versatile
