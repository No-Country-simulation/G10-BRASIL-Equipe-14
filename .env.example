# n8n
N8N_VERSION=2.41.3
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
TIMEZONE=America/Sao_Paulo

# LLMs (camada gratuita). Nunca commite a chave real: ela vai só no .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
