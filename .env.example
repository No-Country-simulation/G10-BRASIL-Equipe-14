# n8n
N8N_VERSION=2.41.3
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
TIMEZONE=America/Sao_Paulo

# Streamlit
STREAMLIT_PORT=8501

# Streamlit -> n8n (no docker compose use N8N_BASE_URL=http://n8n:5678)
N8N_BASE_URL=https://bot.rsa.ia.br
N8N_INGESTION_WEBHOOK_PATH=webhook/ingestion
# N8N_INGESTION_WEBHOOK_URL=   # opcional: sobrescreve BASE_URL + PATH
N8N_REQUEST_TIMEOUT=30
N8N_API_KEY=
# N8N_DOWNLOAD_WEBHOOK_URL=https://bot.rsa.ia.br/webhook/wf05-download-bucket-OCI

# Armazenamento OCI: configuração compartilhada pelo SDK e pelo DuckDB
OCI_REGION=sa-saopaulo-1
OCI_NAMESPACE=grue2tm7tuaq
OCI_BUCKET_NAME=communitylab-assets

# SDK OCI (S2-04): credenciais no ~/.oci/config.
# DuckDB: Customer Secret Key compatível com S3; não é a chave PEM.
OCI_S3_ACCESS_KEY_ID=
OCI_S3_SECRET_ACCESS_KEY=
